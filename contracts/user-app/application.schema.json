{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurun.dev/contracts/user-app/application.schema.json",
  "title": "Neurun user application descriptor",
  "description": "Metadata for an application that consumes Neurun. This descriptor never authorizes Neurun to clone, build, or execute application source code.",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "workflow",
    "container",
    "artifacts",
    "environments"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "workflow": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+\\.json$",
      "maxLength": 256,
      "not": {
        "pattern": "\\.\\."
      }
    },
    "container": {
      "type": "object",
      "required": [
        "context",
        "dockerfile"
      ],
      "properties": {
        "context": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$",
          "maxLength": 256,
          "not": {
            "pattern": "\\.\\."
          }
        },
        "dockerfile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$",
          "maxLength": 256,
          "not": {
            "pattern": "\\.\\."
          }
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": [
        "directory"
      ],
      "properties": {
        "directory": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$",
          "maxLength": 256,
          "not": {
            "pattern": "\\.\\."
          }
        }
      },
      "additionalProperties": false
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      }
    }
  },
  "additionalProperties": false
}
