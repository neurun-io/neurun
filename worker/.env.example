REDIS_ADDR=localhost:6379
WORKER_REQUEST_STREAM=goflow:node_run_requests
WORKER_REQUEST_GROUP=goflow:node_run_requests:group
WORKER_RESPONSE_STREAM=goflow:node_run_responses

R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=dagflows-builds
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=builds

WORKER_MIN_FREE_MEMORY_MB=512
FIRECRACKER_RUNNER_COMMAND=/usr/local/bin/dagflows-firecracker-runner