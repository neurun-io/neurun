# Development defaults.
#
# There are no credentials here. The server creates no accounts and no API
# keys; make the first one with `neurun user create <username>`, then sign in
# and issue keys through the API.
NEURUN_HTTP_ADDR=:1267
NEURUN_PUBLIC_URL=http://localhost:1267
NEURUN_LOG_LEVEL=info
NEURUN_DEFAULT_PROJECT_ID=prj_local
NEURUN_DATABASE_URL=postgres://neurun:neurun-local-change-me@localhost:5432/neurun?sslmode=disable
NEURUN_DATA_DIRECTORY=data

# Where artifact payloads live. "local" is the appliance shape — one host owning
# its own disk. "s3" is the hosted one and is always fronted by a read-through
# cache under NEURUN_DATA_DIRECTORY/cache, because the worker materializes a
# build's layers on every execution.
# Sessions. Required, like the database: without it every restart signs
# everybody out. The server refuses to boot when it does not answer.
NEURUN_REDIS_URL=redis://localhost:6379/0
# Toolchain caches, kept between builds. Defaults inside the data directory —
# without it every build is cold, which for cargo and npm is minutes.
NEURUN_BUILD_CACHE_DIRECTORY=

NEURUN_ARTIFACT_STORE=local
NEURUN_ARTIFACT_CACHE_KBS=8388608
# Cloudflare R2: the endpoint is https://<account_id>.r2.cloudflarestorage.com
# and the region is "auto". Any S3-compatible bucket works the same way.
NEURUN_S3_BUCKET=
NEURUN_S3_ENDPOINT=
NEURUN_S3_REGION=auto
NEURUN_S3_ACCESS_KEY_ID=
NEURUN_S3_SECRET_ACCESS_KEY=
# Address the bucket in the path when its name is not a valid DNS label.
NEURUN_S3_PATH_STYLE=false
NEURUN_PYTHON_EXECUTABLE=python3
# Where the execution image keeps the neurun-browser executable. Handed to a
# handler as NEURUN_BROWSER_SERVICE; the child environment is an allowlist, so a
# browser service not named here is one an app cannot find. No default: the
# image ships none yet.
NEURUN_BROWSER_SERVICE=
# The Chrome every browser session runs. The browser service inherits this
# process's environment, so setting it here is what reaches it. Unset lets
# rustenium download one, whose version nothing here chose.
NEURUN_CHROME_PATH=
# Where handlers reach the control plane. Loopback only: the caller on the other
# end is the tenant's own code, and the server refuses to bind anywhere routable.
NEURUN_GRPC_ADDRESS=127.0.0.1:1268
# Toolchains for the non-Python runtimes. Each is only reachable if the image
# actually ships it; a missing one fails the build that asked for it.
NEURUN_CARGO_EXECUTABLE=cargo
NEURUN_GO_EXECUTABLE=go
NEURUN_RUBY_EXECUTABLE=ruby
NEURUN_BUNDLE_EXECUTABLE=bundle
NEURUN_NODE_EXECUTABLE=node
NEURUN_NPM_EXECUTABLE=npm
# Required for the local subprocess adapter. This does not isolate tenants.
NEURUN_TRUSTED_CODE_EXECUTION=true
NEURUN_SHUTDOWN_TIMEOUT=10s

NEURUN_MAX_REQUEST_BODY_KBS=1024
NEURUN_MAX_DEPLOYMENT_SOURCE_KBS=32768
NEURUN_MAX_DEPLOYMENT_EXPANDED_KBS=262144
NEURUN_MAX_DEPLOYMENT_ARTIFACT_KBS=262144
NEURUN_MAX_DEPLOYMENT_ARCHIVE_ENTRIES=1000
NEURUN_DEPLOYMENT_BUILD_TIMEOUT=5m

# GitHub App. Absent credentials are not an error: repository deploys refuse
# and uploads keep working. The app needs one repository permission, Contents
# read, and the push event; the private key is the base64 of its PEM, and the
# webhook secret is the one set on the app itself.
NEURUN_GITHUB_APP_ID=
NEURUN_GITHUB_PRIVATE_KEY=
NEURUN_GITHUB_WEBHOOK_SECRET=

NEURUN_MAX_EXECUTION_INPUT_KBS=1024
NEURUN_MAX_EXECUTION_RESULT_KBS=4096
NEURUN_MAX_EXECUTION_LOG_KBS=256
NEURUN_EXECUTION_TIMEOUT=5m
NEURUN_WORKER_POLL_INTERVAL=250ms

NEURUN_OPERATOR_SESSION_TTL=12h
NEURUN_OPERATOR_COOKIE_SECURE=false

# Origins the dashboard is served from. A wildcard is illegal alongside the
# session cookie, so these are named exactly. Comma-separated.
NEURUN_ALLOWED_ORIGINS=http://localhost:3001
# Where the browser reaches the control plane.
NEXT_PUBLIC_NEURUN_API_URL=http://localhost:1267
# The GitHub App's slug, which its install URL is keyed by. Without it the
# organization page cannot offer an install link.
NEXT_PUBLIC_NEURUN_GITHUB_APP_SLUG=neurun-io

NEURUN_HTTP_PORT=1267
NEURUN_DASHBOARD_PORT=3001
POSTGRES_PASSWORD=neurun-local-change-me
