{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurun.dev/contracts/events/job-event.schema.json",
  "title": "Neurun job event",
  "type": "object",
  "required": [
    "id",
    "job_id",
    "sequence",
    "type",
    "state",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{64}$"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "job.accepted",
        "job.queued",
        "job.leased",
        "job.started",
        "job.lease_renewed",
        "job.retry_wait",
        "job.succeeded",
        "job.rejected",
        "job.failed",
        "job.canceled",
        "job.dead_lettered",
        "attempt.lease_expired",
        "attempt.failed"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "accepted",
        "queued",
        "leased",
        "running",
        "retry_wait",
        "succeeded",
        "rejected",
        "failed",
        "canceled",
        "dead_lettered"
      ]
    },
    "payload": {},
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
