AWS_REGION=us-east-1
AWS_ENDPOINT_URL_SQS=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SESSION_TOKEN=

SQS_REQUEST_QUEUE_NAME=builder-requests
SQS_RESPONSE_QUEUE_NAME=builder-responses
SQS_REQUEST_QUEUE_URL=http://localhost:4566/000000000000/builder-requests
SQS_RESPONSE_QUEUE_URL=http://localhost:4566/000000000000/builder-responses
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=900

R2_ACCOUNT_ID=
R2_ENDPOINT=http://localhost:4566
R2_REGION=us-east-1
R2_BUCKET=dagflows-builds
R2_ACCESS_KEY_ID=test
R2_SECRET_ACCESS_KEY=test
R2_PREFIX=builds

# Docker Compose settings
MINISTACK_VERSION=1.4.2
MINISTACK_BIND_ADDRESS=127.0.0.1
MINISTACK_PORT=4566
MINISTACK_LOG_LEVEL=INFO
BUILDER_PLATFORM=linux/amd64
GO_VERSION=1.25
NODE_VERSION=24
