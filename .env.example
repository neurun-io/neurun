# Development defaults.
#
# There are no credentials here. The server creates no accounts and no API
# keys; make the first one with `neurun user create <username>`, then sign in
# and issue keys through the API.
NEURUN_HTTP_ADDR=:1267
NEURUN_PUBLIC_URL=http://localhost:1267
NEURUN_LOG_LEVEL=info
NEURUN_DEFAULT_PROJECT_ID=prj_local
NEURUN_DATABASE_URL=postgres://neurun:neurun-local-change-me@localhost:5432/neurun?sslmode=disable
NEURUN_DATA_DIRECTORY=data
NEURUN_PYTHON_EXECUTABLE=python3
# Required for the local subprocess adapter. This does not isolate tenants.
NEURUN_TRUSTED_CODE_EXECUTION=true
NEURUN_SHUTDOWN_TIMEOUT=10s

NEURUN_MAX_REQUEST_BODY_BYTES=1048576
NEURUN_MAX_DEPLOYMENT_SOURCE_BYTES=33554432
NEURUN_MAX_DEPLOYMENT_EXPANDED_BYTES=268435456
NEURUN_MAX_DEPLOYMENT_ARTIFACT_BYTES=268435456
NEURUN_MAX_DEPLOYMENT_ARCHIVE_ENTRIES=1000
NEURUN_DEPLOYMENT_BUILD_TIMEOUT=5m

# GitHub App. Absent credentials are not an error: repository deploys refuse
# and uploads keep working. The app needs one repository permission, Contents
# read, and the push event; the private key is the base64 of its PEM, and the
# webhook secret is the one set on the app itself.
NEURUN_GITHUB_APP_ID=
NEURUN_GITHUB_PRIVATE_KEY=
NEURUN_GITHUB_WEBHOOK_SECRET=

NEURUN_MAX_EXECUTION_INPUT_BYTES=1048576
NEURUN_MAX_EXECUTION_RESULT_BYTES=4194304
NEURUN_MAX_EXECUTION_LOG_BYTES=262144
NEURUN_EXECUTION_TIMEOUT=5m
NEURUN_WORKER_POLL_INTERVAL=250ms

NEURUN_OPERATOR_SESSION_TTL=12h
NEURUN_OPERATOR_COOKIE_SECURE=false

# Origins the dashboard is served from. A wildcard is illegal alongside the
# session cookie, so these are named exactly. Comma-separated.
NEURUN_ALLOWED_ORIGINS=http://localhost:3001
# Where the browser reaches the control plane.
NEXT_PUBLIC_NEURUN_API_URL=http://localhost:1267
# The GitHub App's slug, which its install URL is keyed by. Without it the
# organization page cannot offer an install link.
NEXT_PUBLIC_NEURUN_GITHUB_APP_SLUG=neurun-io

NEURUN_HTTP_PORT=1267
NEURUN_DASHBOARD_PORT=3001
POSTGRES_PASSWORD=neurun-local-change-me
