{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurun.io/contracts/functions/bundle.schema.json",
  "title": "Neurun atomic-function manifest bundle",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_version",
    "digest",
    "manifests"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "bundle_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "minLength": 1
    },
    "manifests": {
      "type": "array",
      "items": {
        "$ref": "manifest.schema.json"
      }
    }
  },
  "additionalProperties": false
}
