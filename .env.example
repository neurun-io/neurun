# Development-only configuration. Replace every credential outside local use.
NEURUN_HTTP_ADDR=:1267
NEURUN_PUBLIC_URL=http://localhost:1267
NEURUN_LOG_LEVEL=info
NEURUN_API_KEY=neu_live_local.development-only-change-me
NEURUN_DEFAULT_PROJECT_ID=prj_local
NEURUN_ARTIFACT_DIRECTORY=data/artifacts
NEURUN_BLOCK_PRIVATE_NETWORKS=true
# Enables the asynchronous job, invoke and fetch routes against the
# process-local backend, which reports durability=process_local and loses queued
# jobs on restart. Unset, those routes fail closed with HTTP 503
# durable_backend_unavailable; synchronous execution is unaffected either way.
NEURUN_ALLOW_VOLATILE_JOBS=true
NEURUN_SHUTDOWN_TIMEOUT=10s

# Human logins for the operator dashboard, as `username:role:hash` entries
# separated by `;`. Empty means only API-key access works — the dashboard will
# say so rather than showing a sign-in form that cannot succeed.
#
# Populate it with `scripts/create-operator.sh`, which hashes the password and
# writes only the hash. Roles: admin (all scopes), operator (read plus
# submit/cancel), viewer (read only). Passwords are at least 12 characters.
NEURUN_OPERATOR_ACCOUNTS=
NEURUN_OPERATOR_SESSION_TTL=12h
# Secure cookies are permitted on http://localhost by current browsers, so this
# stays true for local development. Set it false only for a plain-HTTP host that
# is not localhost.
NEURUN_OPERATOR_COOKIE_SECURE=true

# Docker Compose port overrides and dependency credentials.
NEURUN_HTTP_PORT=1267
NEURUN_DASHBOARD_PORT=3000
POSTGRES_PASSWORD=neurun-local-change-me
