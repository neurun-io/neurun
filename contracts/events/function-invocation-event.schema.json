{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurun.dev/contracts/events/function-invocation-event.schema.json",
  "title": "Neurun atomic-function invocation event",
  "type": "object",
  "required": [
    "id",
    "type",
    "project_id",
    "invocation_id",
    "function",
    "trace_id",
    "occurred_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "function.invocation.accepted",
        "function.invocation.started",
        "function.invocation.succeeded",
        "function.invocation.rejected",
        "function.invocation.failed",
        "function.invocation.canceled"
      ]
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": ["string", "null"]
    },
    "attempt_id": {
      "type": ["string", "null"]
    },
    "function": {
      "type": "object",
      "required": ["name", "version", "digest"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "trace_id": {
      "type": "string",
      "minLength": 16
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "failure": {
      "type": ["object", "null"]
    },
    "usage": {
      "type": ["object", "null"]
    }
  },
  "additionalProperties": false
}

